{
  extends: [
    'github>camunda/infraex-common-config:default.json5',
    ':semanticCommitTypeAll(deps)',
    // Rebase Renovate PRs only on real conflicts, not on every base-branch push.
    // Provides rebaseWhen: conflicted, rebaseLabel: rebase, keepUpdatedLabel: keep-updated.
    'github>camunda/infra-renovate-config:rebase.json5',
  ],
  ignorePaths: [
    '**/node_modules/**',
    '**/bower_components/**',
    '**/vendor/**',
    '**/examples/**',
    '**/__tests__/**',
    '**/test/**',
    '**/tests/**',
    '**/__fixtures__/**',
  ],
  semanticCommitScope: '',
  labels: [
    'dependencies',
  ],
  separateMinorPatch: true,
  ignoreTests: false,
  prCreation: 'not-pending',
  digest: {
    enabled: true,
    addLabels: ['upgrade:digest'],
  },
  lockFileMaintenance: {
    enabled: true,
    schedule: ['before 5am on the first day of the month'],
    groupName: 'npm lockfiles',
    automerge: false,
    platformAutomerge: false,
    recreateWhen: 'auto',
    addLabels: ['deps/tools', 'kind/chore'],
  },
  'helm-values': {
    fileMatch: [
      '(^|/).*?values.*?\\.yaml$',
    ],
  },
  // GitHub Actions configuration
  'github-actions': {
    enabled: true,
    fileMatch: [
      '^\\.github/workflows/[^/]+\\.ya?ml$',
    ],
  },
  packageRules: [
    {
      description: 'This repository is the source of custom.helm-camunda, so it keeps the asdf helm/helm updates the preset disables.',
      matchManagers: ['asdf'],
      matchPackageNames: ['helm/helm'],
      enabled: true,
    },
    {
      description: 'Keep devDependency ranges instead of the preset pinDevDependencies.',
      matchDepTypes: ['devDependencies'],
      rangeStrategy: 'auto',
    },
    {
      description: 'Bitnami Premium os-shell tags are <major>-debian-<n>-rN; rN maps to build, as in the shared rule.',
      matchDatasources: ['custom.bitnami-os-shell-camunda'],
      versioning: 'regex:^(?<major>\\d+)-(?<compatibility>debian-\\d+)-r(?<build>\\d+)$',
    },
    // vendor-ee images with a renovate annotation in the 8.7/8.8/8.9 enterprise values are sourced from
    // their bitnami-<x>-camunda custom datasources (see customManagers);
    // disable the docker/helm-values tracking for it so it is not bumped twice.
    // vendor-ee/elasticsearch is intentionally NOT wired here: the chart pins a
    // plain tag (e.g. 8.19.16) while the published feed uses the
    // '<x.y.z>-debian-12-rN' scheme, so it needs separate handling.
    {
      description: 'Bitnami enterprise images tracked via custom datasource, not docker.',
      matchManagers: ['helm-values'],
      matchFileNames: [
        'charts/camunda-platform-8.7/values-enterprise.yaml',
        'charts/camunda-platform-8.8/values-enterprise.yaml',
        'charts/camunda-platform-8.9/values-enterprise.yaml',
      ],
      matchPackageNames: ['/vendor-ee/(postgresql|os-shell|postgres-exporter|elasticsearch-exporter|keycloak-config-cli)$/'],
      enabled: false,
    },
    {
      description: 'Major updates require manual review to prevent breaking changes.',
      matchUpdateTypes: ['major'],
      matchManagers: ['!github-actions'],
      automerge: false,
      platformAutomerge: false,
      dependencyDashboardApproval: false,
      addLabels: ['requires-manual-review'],
    },
    {
      description: 'Schedule major updates for Friday nights.',
      matchUpdateTypes: ['major'],
      matchManagers: ['!github-actions'],
      excludePackageNames: ['/.*camunda.*/'],
      schedule: ['* 0-6,18-23 * * 5'],
    },
    {
      description: 'Camunda packages are not bound to the preset update schedules.',
      matchPackageNames: ['/.*camunda.*/'],
      schedule: ['at any time'],
    },
    {
      addLabels: ['deps/charts'],
      matchFileNames: [
        'charts/*/Chart.yaml',
        'charts/*/values*.yaml',
        'charts/*/go.*',
      ],
    },
    {
      addLabels: ['deps/tools'],
      matchFileNames: ['.tool-versions'],
      schedule: ['every weekend'],
    },
    {
      matchManagers: ['custom.regex'],
      matchDepNames: ['helm/helm'],
      allowedVersions: '<4.0.0',
    },
    {
      addLabels: [
        'deps/github-actions',
        'automation/renovatebot',
        'kind/chore',
      ],
      matchManagers: ['github-actions'],
      schedule: ['every weekend'],
    },
    {
      description: 'Group every Go version pin (go.mod, Dockerfiles, .tool-versions) into one PR.',
      matchDatasources: ['golang-version'],
      groupName: 'golang',
    },
    {
      matchManagers: ['asdf'],
      matchDepNames: ['golang'],
      groupName: 'golang',
    },
    {
      description: 'Bump the go.mod go directive like the other Go version pins.',
      matchManagers: ['gomod'],
      matchDepNames: ['go'],
      matchDepTypes: ['golang'],
      rangeStrategy: 'bump',
    },
    // Limit tools and libs versions to the actual Distro CI Kubernetes cluster.
    {
      allowedVersions: '<1.37.0',
      matchDepNames: [
        '/kubectl/',
      ],
    },
    {
      allowedVersions: '<0.28.0',
      matchDepNames: [
        '/k8s.io/.*/',
      ],
    },
    // Camunda chart version policies
    {
      description: 'Disable major updates for Helm dependencies to prevent breaking changes.',
      enabled: false,
      matchManagers: ['helm', 'helm-values', 'custom.regex'],
      matchUpdateTypes: ['major'],
    },
    {
      description: 'Re-enable major updates for annotated .tool-versions tools (still flagged for manual review).',
      enabled: true,
      matchManagers: ['custom.regex'],
      matchFileNames: ['.tool-versions'],
      matchUpdateTypes: ['major'],
    },
    // Internal scripts do not need to be updated as they are not versioned outside of git
    // dependencies for those scripts will still be updated.
    {
      matchPackageNames: [
        'scripts/camunda-core',
        'scripts/prepare-helm-values',
        'scripts/vault-secret-mapper',
      ],
      enabled: false,
    },
    {
      description: 'Disable minor updates for Camunda components in previous chart versions.',
      enabled: false,
      matchPackageNames: ['/.*camunda/[.-]*/', '/registry.camunda.cloud/[.-/]*/'],
      matchFileNames: [
        'charts/camunda-platform-8.*/values.yaml',
        'charts/camunda-platform-8.*/values-latest.yaml',
        'charts/camunda-platform-8.*/values-digest.yaml',
      ],
      matchUpdateTypes: ['minor'],
    },
    {
      description: 'Disable archived Elasticsearch curator image.',
      enabled: false,
      matchPackageNames: [
        'bitnamilegacy/elasticsearch-curator-archived',
        'elasticsearch-curator-archived',
      ],
    },
    // Elasticsearch version constraints per chart version
    // Limit Elasticsearch version to latest supported version in Camunda 8.7 chart.
    // https://docs.camunda.io/docs/reference/supported-environments/#camunda-8-self-managed
    {
      matchDatasources: [
        'docker',
      ],
      matchFileNames: [
        'charts/camunda-platform-8.7/values.yaml',
        'charts/camunda-platform-8.7/values-latest.yaml',
      ],
      matchPackageNames: [
        '/.*elasticsearch.*/',
      ],
      allowedVersions: '~8.17.0',
    },
    // Limit Elasticsearch version to 8.x in Camunda 8.8 and 8.9 charts (Bitnami subchart removed in 8.10).
    {
      matchDatasources: [
        'docker',
      ],
      matchFileNames: [
        'charts/camunda-platform-8.8/values.yaml',
        'charts/camunda-platform-8.8/values-latest.yaml',
        'charts/camunda-platform-8.8/values-enterprise.yaml',
        'charts/camunda-platform-8.9/values.yaml',
        'charts/camunda-platform-8.9/values-latest.yaml',
        'charts/camunda-platform-8.9/values-enterprise.yaml',
      ],
      matchPackageNames: [
        '/.*elasticsearch.*/',
      ],
      allowedVersions: '>=8.0.0 <9.0.0',
    },
    // Limit alpha chart version to alpha tags only.
    {
      enabled: true,
      matchDatasources: [
        'github-tags',
      ],
      matchPackageNames: [
        'camunda/camunda',
      ],
      matchFileNames: [
        // bump these to whatever the latest alpha is
        'charts/camunda-platform-8.11/Chart.yaml',
      ],
      versioning: 'regex:^(?<major>\\d+)(\\.(?<minor>\\d+))(\\.(?<patch>\\d+))(-(?<prerelease>alpha\\d+))$',
    },
    {
      enabled: true,
      groupName: 'camunda-platform-images',
      matchPackageNames: [
        '/.*camunda.*/',
      ],
      matchDatasources: [
        'helm',
        'helm-values',
        'docker',
        'regex',
      ],
      matchFileNames: [
        'charts/camunda-platform-8.7/Chart.yaml',
        'charts/camunda-platform-8.7/values.yaml',
        'charts/camunda-platform-8.7/values-latest.yaml',
        'charts/camunda-platform-8.7/values-enterprise.yaml',
        'charts/camunda-platform-8.8/Chart.yaml',
        'charts/camunda-platform-8.8/values.yaml',
        'charts/camunda-platform-8.8/values-latest.yaml',
        'charts/camunda-platform-8.8/values-enterprise.yaml',
        'charts/camunda-platform-8.9/Chart.yaml',
        'charts/camunda-platform-8.9/values.yaml',
        'charts/camunda-platform-8.9/values-latest.yaml',
        'charts/camunda-platform-8.9/values-enterprise.yaml',
        'charts/camunda-platform-8.10/Chart.yaml',
        'charts/camunda-platform-8.10/values.yaml',
        'charts/camunda-platform-8.10/values-latest.yaml',
      ],
      matchUpdateTypes: ['patch', 'pin'],
      schedule: ['at any time'],
      addLabels: ['camunda-platform', 'priority-high'],
      prCreation: 'immediate',
    },
    {
      enabled: true,
      groupName: 'camunda-platform-images',
      matchPackageNames: [
        '/.*camunda.*/',
      ],
      matchDatasources: [
        'helm',
        'helm-values',
        'docker',
        'regex',
      ],
      matchFileNames: [
        'charts/camunda-platform-8.11/Chart.yaml',
        'charts/camunda-platform-8.11/values.yaml',
        'charts/camunda-platform-8.11/values-latest.yaml',
      ],
      matchUpdateTypes: ['major', 'minor', 'patch'],
      schedule: ['at any time'],
      addLabels: ['camunda-platform', 'priority-high'],
      prCreation: 'immediate',
    },
    {
      description: 'Parse Camunda alpha chart image tags as semver so alpha updates work',
      enabled: true,
      matchPackageNames: ['/.*camunda.*/'],
      matchDatasources: ['helm', 'helm-values', 'docker', 'regex'],
      matchFileNames: [
        'charts/camunda-platform-8.11/Chart.yaml',
        'charts/camunda-platform-8.11/values.yaml',
        'charts/camunda-platform-8.11/values-latest.yaml',
      ],
      versioning: 'regex:^(?<major>\\d+)(\\.(?<minor>\\d+))(\\.(?<patch>\\d+))(-(?<prerelease>alpha\\d+))$',
    },
    {
      description: 'Digest pins age against the tag\'s tag_last_pushed, not the digest, so a SNAPSHOT tag re-pushed hourly can never satisfy a release-age soak; snapshot pins carry none.',
      enabled: true,
      groupName: 'camunda-platform-digests',
      matchPackageNames: [
        '/.*camunda.*/',
      ],
      matchDatasources: [
        'helm',
        'docker',
        'regex',
      ],
      matchFileNames: [
        'charts/camunda-platform-8.8/values-digest.yaml',
        'charts/camunda-platform-8.9/values-digest.yaml',
        'charts/camunda-platform-8.10/values-digest.yaml',
        'charts/camunda-platform-8.11/values-digest.yaml',
      ],
      matchUpdateTypes: ['digest'],
      schedule: ['at any time'],
      prCreation: 'immediate',
      addLabels: ['camunda-platform', 'priority-high'],
    },
    {
      description: 'Release tags and latest are expected to be immutable; a moved digest there is a re-publish, so hold it for six hours before pinning.',
      matchPackageNames: [
        '/.*camunda.*/',
      ],
      matchDatasources: [
        'helm',
        'docker',
        'regex',
      ],
      matchFileNames: [
        'charts/camunda-platform-8.8/values-digest.yaml',
        'charts/camunda-platform-8.9/values-digest.yaml',
        'charts/camunda-platform-8.10/values-digest.yaml',
        'charts/camunda-platform-8.11/values-digest.yaml',
      ],
      matchUpdateTypes: ['digest'],
      matchCurrentValue: '!/SNAPSHOT/',
      minimumReleaseAge: '6 hours',
    },
    {
      matchUpdateTypes: ['minor', 'patch', 'pin', 'digest'],
      addLabels: [
        'automation/renovatebot',
        'kind/chore',
      ],
    },
    // This package name is used by the initContainer for keycloak and doesn't make sense to
    // be processed by renovate because it requires helm templating to render the real image name.
    {
      "matchDepNames": ["{{ .Values.global.identity.image.registry }}/{{ .Values.global.identity.image.repository }}{{ if .Values.global.identity.image.digest }}"],
      "enabled": false
    },
    {
      description: 'Disable all updates for out-of-support chart versions (8.6 and below).',
      enabled: false,
      matchFileNames: [
        'charts/camunda-platform-8.6/**',
      ],
    },
    {
      description: 'Disable lock file maintenance for all managers.',
      matchUpdateTypes: ['lockFileMaintenance'],
      enabled: false,
    },
    {
      description: 'Enable lock file maintenance for the npm workspaces.',
      matchUpdateTypes: ['lockFileMaintenance'],
      matchFileNames: [
        'helm-docs-site/**',
        'helm-values-mcp/**',
      ],
      enabled: true,
    },
  ],
  customManagers: [
    {
      // This is used to update npm packages in GitHub Actions workflows and Makefile.
      customType: 'regex',
      fileMatch: [
        '^\\.github/workflows/.*\\.ya?ml$',
        '^Makefile$',
      ],
      datasourceTemplate: 'npm',
      matchStrings: [
        '# renovate: datasource=npm depName=(?<depName>[^\\s]+?)\\s*\\n\\s*npm install -g [^\\s]+?@(?<currentValue>\\S+)',
        '# renovate: datasource=npm depName=(?<depName>[^\\s]+?)\\s*\\n\\s*readmeGeneratorVersion = (?<currentValue>\\S+)',
      ],
      versioningTemplate: 'semver',
    },
    // Keep repository, tag, and digest adjacent so a digest-less image block
    // cannot consume the digest from the next component.
    {
      customType: 'regex',
      fileMatch: [
        'values-digest\\.yaml$'
      ],
      matchStrings: [
        /*
        # Example.
        orchestration:
          image:
            repository: camunda/camunda
            tag: SNAPSHOT
            digest: "sha256:abcdef123456789..."
        */
        'repository:\\s+(?<depName>\\S+)\\s*\\n\\s+tag:\\s+(?<currentValue>\\S+)\\s*\\n\\s+digest:\\s+\"?(?<currentDigest>sha256:[a-f0-9]{64})\"?'
      ],
      datasourceTemplate: 'docker',
      versioningTemplate: 'docker',
    },
    {
      customType: 'regex',
      fileMatch: [
        '^charts/camunda-platform-[^/]+/test/ci/registry/scenarios/[^/]+\\.yaml$',
        '^charts/camunda-platform-[^/]+/test/ci/registry-snapshot\\.yaml$',
        '^scripts/camunda-core/pkg/releasenotes/releasenotes\\.go$',
        '^charts/camunda-platform-[^/]+/test/ci-test-config\\.yaml$',
      ],
      matchStrings: [
        'helmVersion: (?<currentValue>\\S+)',
        'const helmV3Version = "(?<currentValue>[^"]+)"',
        'helmCompat:\\n\\s+versions:\\n\\s+- "3\\.10\\.\\d+"\\n\\s+- "(?<currentValue>[^"]+)"',
      ],
      depNameTemplate: 'helm/helm',
      datasourceTemplate: 'github-releases',
      extractVersionTemplate: '^v(?<version>\\S+)',
      versioningTemplate: 'semver',
    },
    {
      customType: 'regex',
      fileMatch: [
        '^\\.github/docker/[^/]+/Dockerfile$',
      ],
      matchStrings: [
        'ARG (?:GOLANG_VERSION|GO_VERSION)=(?<currentValue>\\d+\\.\\d+\\.\\d+)',
      ],
      depNameTemplate: 'go',
      datasourceTemplate: 'golang-version',
    // Tools the asdf manager does not know. Same annotation syntax as
    // camunda/infraex-common-config, so this manager can go once the repo extends it.
    },
    {
      customType: 'regex',
      fileMatch: [
        '(^|/)\\.tool-versions$',
      ],
      matchStrings: [
        '# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)(?: extractVersion=(?<extractVersion>\\S+))?[ \\t]*\\r?\\n[^\\s#]+[ \\t]+(?<currentValue>[^\\s#]+)',
      ],
      extractVersionTemplate: '{{#if extractVersion}}{{{extractVersion}}}{{else}}^(?<version>.+)${{/if}}',
      versioningTemplate: 'semver',
    },
  ],
  hostRules: [
    {
      hostType: 'docker',
      matchHost: 'https://registry.camunda.cloud',
      username: 'ci-distribution',
      password: '{{ secrets.DISTRO_CAMUNDA_DOCKER_REGISTRY_PASSWORD }}',
    },
  ],
}
