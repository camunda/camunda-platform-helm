- apiVersion: deploy-camunda/v1
  kind: Recipe
  metadata:
    name: keycloak-original-install
    catalogue: builtin/8.9
    description: registry scenario keycloak-original (shortname kcor, tier 0, enabled false)
  spec:
    chart:
      version: "8.9"
      path: charts/camunda-platform-8.9
    values:
      - auth:keycloak
      - identity:keycloak
      - persistence:elasticsearch
    requires:
      - slot: platform
        oneOf:
          - gke
      - slot: flow
        oneOf:
          - install
    providers:
      infra.gke: distroci
